{
  "name": "cpms-backend",
  "version": "1.0.0",
  "description": "Campus Placement Management System - REST API (Node.js, Express, MongoDB)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "seed:reset": "node scripts/seed.js --reset",
    "create-admin": "node scripts/createSuperAdmin.js",
    "sync-indexes": "node scripts/syncIndexes.js",
    "backup": "node scripts/backup.js",
    "test": "node tests/run.js",
    "test:unit": "node tests/run.js unit",
    "test:integration": "node tests/run.js integration"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "nodemailer": "^6.9.15",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
