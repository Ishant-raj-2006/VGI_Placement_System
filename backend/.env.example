# ---- Server ----
NODE_ENV=development
PORT=5000
# Public URL of the React app (used in e-mail links and CORS)
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ---- MongoDB ----
# Local development:
MONGODB_URI=mongodb://127.0.0.1:27017/campus_placement
MONGO_MAX_POOL_SIZE=20
# Atlas / production example (use a least-privilege DB user):
# MONGODB_URI=mongodb+srv://cpms_app:<password>@cluster0.xxxxx.mongodb.net/campus_placement?retryWrites=true&w=majority
# Build indexes automatically on startup (set false in large production DBs and run `npm run sync-indexes` during deploys)
MONGO_AUTO_INDEX=true

# ---- Authentication ----
# REQUIRED in production: at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-in-production-use-a-long-random-string
# Session lifetime (can be overridden at runtime from Super Admin > System Settings)
SESSION_TTL_HOURS=12
BCRYPT_ROUNDS=12
# Max failed logins before the account is temporarily locked
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ---- Rate limiting ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
LOGIN_RATE_LIMIT_MAX=20

# ---- File storage (private; never served statically) ----
# Use vercel-blob for durable uploads when deploying the API to Vercel.
STORAGE_DRIVER=local
STORAGE_DIR=./storage
MAX_RESUME_MB=2
MAX_OFFER_DOC_MB=5
MAX_IMPORT_MB=5

# ---- E-mail (optional). If SMTP_HOST is empty, e-mails are only logged to the console + EmailLog collection ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CPMS Placement Cell <no-reply@college.edu>"
EMAIL_MAX_ATTEMPTS=5

# ---- Development helpers (NEVER enable in production) ----
# Returns verification/reset tokens in API responses so the flows can be tried without SMTP.
EXPOSE_DEV_TOKENS=true

# ---- Background jobs ----
JOBS_ENABLED=true

# ---- Seed script ----
SEED_ADMIN_EMAIL=admin@college.edu
SEED_ADMIN_PASSWORD=Admin@12345

# ---- Serving the React app from this process (optional) ----
# After `npm run build` in /frontend, the API also serves the built app at "/" (single-container deployment).
# Set SERVE_FRONTEND=false if nginx / a CDN serves the frontend instead.
SERVE_FRONTEND=true
FRONTEND_DIST=../frontend/dist
